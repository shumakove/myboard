# Скопируйте в .env рядом с compose.yaml и заполните. .env не коммитится.

# Порт Caddy на машине: 80 — стек QA, 8080 — стек DEV.
HTTP_PORT=80

# Адрес, которым пользуются браузеры: http:// + IP машины в локальной сети
# (узнать на macOS: ipconfig getifaddr en0). Порт указывается, если он не 80.
# Никогда не localhost: телефон его не увидит.
PUBLIC_BASE_URL=http://<LAN-IP>

# Случайная строка, например: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# PostgreSQL: значения должны совпадать с DATABASE_URL.
POSTGRES_DB=myboard
POSTGRES_USER=myboard
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://myboard:change-me@postgres:5432/myboard

# Каталог файлов досок внутри контейнера api (на томе media).
MEDIA_ROOT=/data/media

# Первый администратор создаётся из этих значений при пустой базе.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Максимальный размер загружаемого файла, байт (50 МБ).
MAX_UPLOAD_BYTES=52428800

# Необязательно: как часто открытая доска с правками пишет снимок и сжимает журнал,
# секунд (по умолчанию 300). Для проверки сжатия можно поставить, например, 5.
# SNAPSHOT_INTERVAL_SECONDS=300

# Только для публичного профиля с HTTPS (T11.2).
# SITE_DOMAIN=board.example.com
